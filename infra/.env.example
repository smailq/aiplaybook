# Provisioning config for infra/provision.sh.
# Copy to infra/.env and fill in. infra/.env is gitignored - never commit real
# secrets. Values may be quoted; lines starting with # are ignored.

# --- required ---------------------------------------------------------------
# Supabase project URL.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co

# Supabase secret key (Project Settings -> API Keys -> secret, sb_secret_...).
# Server-side only; it bypasses RLS to record each user's backend URL.
SUPABASE_SECRET_KEY=sb_secret_YOUR-KEY

# The deployed frontend origin (must match the Supabase Site URL). Used for the
# gateway's CORS allow-list on each backend.
FRONTEND_ORIGIN=https://YOUR-APP.vercel.app

# OpenRouter API key for inference. Set a credit cap on it in the OpenRouter
# dashboard - that cap is the Phase 0 cost guardrail.
OPENROUTER_API_KEY=sk-or-YOUR-KEY

# --- optional ---------------------------------------------------------------
# Fly region for the app + volume (must match infra/fly.toml primary_region).
# FLY_REGION=iad

# OpenRouter model id for /ask. Leave unset to use the agent's config default.
# HERMES_MODEL=nousresearch/hermes-3-llama-3.1-70b

# Override the JWKS URL if your project serves it elsewhere.
# SUPABASE_JWKS_URL=https://YOUR-PROJECT.supabase.co/auth/v1/.well-known/jwks.json
