# Copy to web/.env.local and fill in from your Supabase project settings.
# Both are safe to expose in the browser bundle (they are public by design):
# the anon key only grants what RLS allows, and every backend call carries the
# user's own short-lived access token - never a service-role key.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY
