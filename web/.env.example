# Copy to web/.env.local and fill in from Supabase -> Project Settings -> API Keys.
# The publishable key (sb_publishable_...) is safe to expose in the browser
# bundle by design: it only grants what RLS allows, and every backend call
# carries the user's own short-lived access token - never a secret key.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR-KEY
