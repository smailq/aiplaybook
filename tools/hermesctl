#!/usr/bin/env bash
#
# hermesctl - manage multiple Hermes agents in Apple `container`.
#
# Each agent is one directory on the host, mounted into the container at
# /opt/data (Hermes's HERMES_HOME). Because every agent gets its own host
# directory, their memory, skills, sessions, config, and .env are fully
# isolated from one another and persist across container restarts and image
# updates.
#
#   Agent layout on host:
#     $HERMES_AGENTS_HOME/<name>/data/   -> mounted to /opt/data (all state)
#     $HERMES_AGENTS_HOME/<name>/.env    -> optional, passed via --env-file
#
# Requirements: Apple `container` (https://github.com/apple/container), macOS.
#
set -euo pipefail

# ---- configuration (override via environment) -------------------------------
HERMES_IMAGE="${HERMES_IMAGE:-nousresearch/hermes-agent:latest}"
HERMES_AGENTS_HOME="${HERMES_AGENTS_HOME:-$HOME/hermes-agents}"
# Map the in-container `hermes` user to the host user so files written under
# the mounted data dir stay owned by (and editable as) you on the host.
HERMES_UID_VAL="${HERMES_UID:-$(id -u)}"
HERMES_GID_VAL="${HERMES_GID:-$(id -g)}"

# ---- helpers ----------------------------------------------------------------
prog="$(basename "$0")"

die() { printf 'error: %s\n' "$*" >&2; exit 1; }
info() { printf '%s\n' "$*" >&2; }

need_container() {
  command -v container >/dev/null 2>&1 || die "Apple 'container' CLI not found. Install: brew install container"
  # Ensure the system service is up (idempotent, fast if already running).
  if ! container system status >/dev/null 2>&1; then
    info "Starting container system service..."
    container system start >/dev/null
  fi
}

valid_name() {
  case "$1" in
    ''|*[!a-zA-Z0-9_-]*) return 1 ;;
    *) return 0 ;;
  esac
}

agent_dir()  { printf '%s/%s' "$HERMES_AGENTS_HOME" "$1"; }
data_dir()   { printf '%s/%s/data' "$HERMES_AGENTS_HOME" "$1"; }
env_file()   { printf '%s/%s/.env' "$HERMES_AGENTS_HOME" "$1"; }
cname()      { printf 'hermes-%s' "$1"; }

require_name() {
  [ $# -ge 1 ] && [ -n "${1:-}" ] || die "missing agent name. Usage: $prog $ACTION <name>"
  valid_name "$1" || die "invalid agent name '$1' (use letters, digits, - and _ only)"
}

require_agent() {
  [ -d "$(agent_dir "$1")" ] || die "agent '$1' does not exist. Create it: $prog create $1"
}

# Assemble common `container run` arguments for an agent.
# Sets the RUN_ARGS array.
build_run_args() {
  local name="$1"; shift
  RUN_ARGS=(
    --volume "$(data_dir "$name"):/opt/data"
    --env "HERMES_UID=$HERMES_UID_VAL"
    --env "HERMES_GID=$HERMES_GID_VAL"
  )
  local ef; ef="$(env_file "$name")"
  [ -f "$ef" ] && RUN_ARGS+=(--env-file "$ef")
}

container_exists() { container list --all --format json 2>/dev/null | grep -q "\"$(cname "$1")\"" ; }
container_running() { container list --format json 2>/dev/null | grep -q "\"$(cname "$1")\"" ; }

# ---- commands ---------------------------------------------------------------

cmd_pull() {
  need_container
  info "Pulling $HERMES_IMAGE ..."
  container image pull "$HERMES_IMAGE"
  info "Done."
}

cmd_create() {
  require_name "$@"; local name="$1"
  local dir; dir="$(agent_dir "$name")"
  [ -d "$dir" ] && die "agent '$name' already exists at $dir"
  mkdir -p "$(data_dir "$name")"
  local ef; ef="$(env_file "$name")"
  if [ ! -f "$ef" ]; then
    cat > "$ef" <<'EOF'
# Per-agent environment for Hermes. Uncomment / add what you need.
# These are passed into the container via --env-file. Provider API keys can
# also be set interactively with:  hermesctl setup <name>
#
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# OPENROUTER_API_KEY=
# NOUS_API_KEY=
EOF
  fi
  info "Created agent '$name'"
  info "  data:  $(data_dir "$name")"
  info "  env:   $ef"
  info "Next:  $prog setup $name    # configure a provider / API key"
  info "Then:  $prog run $name      # start chatting"
}

cmd_setup() {
  require_name "$@"; local name="$1"; require_agent "$name"
  need_container
  build_run_args "$name"
  info "Launching Hermes setup wizard for '$name' (Ctrl-C to exit)..."
  exec container run --rm -it --name "$(cname "$name")-setup" "${RUN_ARGS[@]}" "$HERMES_IMAGE" setup
}

cmd_run() {
  require_name "$@"; local name="$1"; shift; require_agent "$name"
  need_container
  build_run_args "$name"
  # No extra args -> interactive Hermes. Extra args are passed straight through
  # (e.g. `run <name> --tui`, `run <name> chat -q "hello"`).
  exec container run --rm -it --name "$(cname "$name")" "${RUN_ARGS[@]}" "$HERMES_IMAGE" "$@"
}

cmd_exec() {
  require_name "$@"; local name="$1"; shift; require_agent "$name"
  need_container
  container_running "$name" || die "agent '$name' is not running. Start it with: $prog run $name  (or gateway $name)"
  [ $# -gt 0 ] || set -- hermes
  exec container exec -it "$(cname "$name")" "$@"
}

cmd_gateway() {
  require_name "$@"; local name="$1"; shift; require_agent "$name"
  need_container
  container_running "$name" && die "agent '$name' is already running."
  container_exists "$name" && container rm "$(cname "$name")" >/dev/null 2>&1 || true
  build_run_args "$name"
  # Extra args after the name are appended (e.g. -p 3000:3000 style must be
  # given before the name; gateway subcommand args go after).
  info "Starting gateway for '$name' (detached)..."
  container run -d --name "$(cname "$name")" "${RUN_ARGS[@]}" "$HERMES_IMAGE" gateway run "$@"
  info "Running. Logs: $prog logs $name   Stop: $prog stop $name"
}

cmd_seed() {
  require_name "$@"; local name="$1"; shift; require_agent "$name"
  local soul="" ; local -a knowledge=()
  while [ $# -gt 0 ]; do
    case "$1" in
      --soul)      soul="${2:-}"; shift 2 || die "--soul needs a file path" ;;
      --knowledge) [ -n "${2:-}" ] || die "--knowledge needs a file path"; knowledge+=("$2"); shift 2 ;;
      *)           die "unknown arg '$1' (usage: $prog seed <name> [--soul <file>] [--knowledge <file>]...)" ;;
    esac
  done
  [ -n "$soul" ] || [ ${#knowledge[@]} -gt 0 ] || die "nothing to seed. Give --soul <file> and/or --knowledge <file>."
  if [ -n "$soul" ]; then
    [ -f "$soul" ] || die "soul file not found: $soul"
    cp "$soul" "$(data_dir "$name")/SOUL.md"
    info "Seeded persona -> $(data_dir "$name")/SOUL.md  (injected every message as the agent's identity)"
  fi
  if [ ${#knowledge[@]} -gt 0 ]; then
    local kdir; kdir="$(data_dir "$name")/knowledge"
    mkdir -p "$kdir"
    local f
    for f in "${knowledge[@]}"; do
      [ -f "$f" ] || die "knowledge file not found: $f"
      cp "$f" "$kdir/"
      info "Seeded knowledge -> $kdir/$(basename "$f")"
    done
    info "Next: start the agent and tell it once:"
    info "  \"Read the files in /opt/data/knowledge and save the key facts to your memory.\""
    info "It will curate them into MEMORY.md, which is injected in every future session."
  fi
}

cmd_logs() {
  require_name "$@"; local name="$1"; require_agent "$name"
  need_container
  container_exists "$name" || die "no container for agent '$name'."
  exec container logs -f "$(cname "$name")"
}

cmd_stop() {
  require_name "$@"; local name="$1"; require_agent "$name"
  need_container
  container_running "$name" || { info "agent '$name' is not running."; return 0; }
  container stop "$(cname "$name")" >/dev/null
  container rm "$(cname "$name")" >/dev/null 2>&1 || true
  info "Stopped '$name'."
}

cmd_rm() {
  require_name "$@"; local name="$1"; require_agent "$name"
  need_container
  local purge=0
  [ "${2:-}" = "--purge" ] && purge=1
  container_exists "$name" && { container stop "$(cname "$name")" >/dev/null 2>&1 || true; container rm "$(cname "$name")" >/dev/null 2>&1 || true; }
  if [ "$purge" -eq 1 ]; then
    rm -rf "$(agent_dir "$name")"
    info "Removed agent '$name' and deleted its data."
  else
    info "Stopped and removed container for '$name'. Data kept at $(agent_dir "$name")"
    info "To also delete its memory/data: $prog rm $name --purge"
  fi
}

cmd_list() {
  need_container
  printf '%-20s %-10s %s\n' "AGENT" "STATE" "DATA DIR"
  local running; running="$(container list --format json 2>/dev/null || echo '[]')"
  if [ -d "$HERMES_AGENTS_HOME" ]; then
    for d in "$HERMES_AGENTS_HOME"/*/; do
      [ -d "$d" ] || continue
      local name; name="$(basename "$d")"
      local state="stopped"
      printf '%s' "$running" | grep -q "\"$(cname "$name")\"" && state="running"
      printf '%-20s %-10s %s\n' "$name" "$state" "$(data_dir "$name")"
    done
  fi
}

usage() {
  cat >&2 <<EOF
$prog - manage multiple Hermes agents in Apple container

Agents live under: $HERMES_AGENTS_HOME
Image:             $HERMES_IMAGE

Usage: $prog <command> [args]

  pull                     Pull / update the Hermes image
  create <name>            Create a new agent (its own data dir + .env)
  setup  <name>            Run the Hermes setup wizard for an agent
  seed   <name> [--soul <file>] [--knowledge <file>]...
                           Install a persona (SOUL.md) and/or knowledge files into an agent
  run    <name> [args...]  Start an agent interactively (default: chat/TUI)
  gateway <name> [args...]  Start an agent's messaging gateway (detached)
  exec   <name> [cmd...]   Exec into a running agent (default: hermes)
  logs   <name>            Follow a detached agent's logs
  stop   <name>            Stop a running/detached agent
  rm     <name> [--purge]  Remove an agent's container (--purge also deletes data)
  list                     List all agents and their state

Examples:
  $prog pull
  $prog create alice
  $prog setup alice
  $prog run alice
  $prog gateway alice
  $prog list
EOF
  exit "${1:-1}"
}

# ---- dispatch ---------------------------------------------------------------
[ $# -ge 1 ] || usage 1
ACTION="$1"; shift || true
case "$ACTION" in
  pull)          cmd_pull "$@" ;;
  create)        cmd_create "$@" ;;
  setup)         cmd_setup "$@" ;;
  seed)          cmd_seed "$@" ;;
  run|chat)      cmd_run "$@" ;;
  gateway)       cmd_gateway "$@" ;;
  exec)          cmd_exec "$@" ;;
  logs)          cmd_logs "$@" ;;
  stop)          cmd_stop "$@" ;;
  rm|remove)     cmd_rm "$@" ;;
  list|ls)       cmd_list "$@" ;;
  -h|--help|help) usage 0 ;;
  *)             die "unknown command '$ACTION' (try: $prog help)" ;;
esac
